# URL da API backend (NestJS)
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Google Maps (necessário no browser para mapas/autocomplete)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Opcional. Sem domínio próprio, o site usa por omissão o URL da Vercel
# (ver apps/web/src/config/index.ts). Quando houver domínio, define esta
# variável no Vercel — é a ÚNICA mudança necessária para o metadata,
# sitemap.xml e robots.txt passarem a usar o domínio novo.
NEXT_PUBLIC_SITE_URL=""
